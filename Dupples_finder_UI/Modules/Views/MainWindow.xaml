<Window
    x:Class="Dupples_finder_UI.Modules.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="clr-namespace:Dupples_finder_UI.DTO"
    xmlns:helpers="clr-namespace:Dupples_finder_UI.Modules.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:Dupples_finder_UI.Modules.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    Title="Dupless Finder"
    Width="1000"
    Height="800"
    d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FF222222"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding GridWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Toolbar: Open + Analyze buttons, progress, memory, status  -->
        <ToolBarTray Grid.ColumnSpan="2">
            <ToolBar Band="1" BandIndex="1">
                <CheckBox
                    Margin="2,0,2,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IncludeSubfolders}"
                    ToolTip="When checked, searches all subfolders recursively">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0">
                                                <Border
                                                    x:Name="Border"
                                                    Background="#FF444444"
                                                    BorderBrush="#FF888888"
                                                    BorderThickness="1"
                                                    CornerRadius="2" />
                                                <Path
                                                    x:Name="CheckMark"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 2,5 L 6,9 L 12,1"
                                                    Stroke="White"
                                                    StrokeThickness="2"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFAAAAAA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FFB8D17D"
                        Text="Include subfolders" />
                </CheckBox>
                <Separator />
                <Button Command="{Binding OpenCommand}" ToolTip="Open folder and scan for images">
                    <TextBlock Foreground="White" Text="Open" />
                </Button>
                <Button Command="{Binding AnalyzeCommand}" ToolTip="Re-analyze images (SIFT matching)">
                    <TextBlock Foreground="White" Text="Analyze" />
                </Button>
                <Button
                    Command="{Binding UndoCommand}"
                    ToolTip="Undo last delete (restore file)"
                    Visibility="{Binding UndoVisibility}">
                    <TextBlock Foreground="White" Text="Undo Deletion" />
                </Button>
                <Separator />
                <Label
                    Content="Sensitivity:"
                    FontSize="11"
                    Foreground="LightGray"
                    ToolTip="Lower = stricter matching (fewer, more similar pairs)" />
                <Slider
                    Width="120"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="500"
                    Minimum="20"
                    TickFrequency="10"
                    ToolTip="Score threshold: lower = stricter matching"
                    Value="{Binding ScoreThreshold}" />
                <Label
                    MinWidth="30"
                    d:Content="200"
                    Content="{Binding ScoreThreshold}"
                    ContentStringFormat="{}{0:F0}"
                    FontSize="11"
                    Foreground="LightGray" />

                <Separator Visibility="{Binding UndoVisibility}" />
                <Label
                    Content="{Binding StatusText}"
                    FontSize="11"
                    Foreground="LightGray" />

                <ProgressBar
                    Width="200"
                    ToolTip="{Binding CalcProgressText}"
                    Visibility="{Binding IsProgressVisible}"
                    Value="{Binding CalcProgress}" />
                <Button
                    Command="{Binding CancelCommand}"
                    ToolTip="Cancel current operation"
                    Visibility="{Binding IsProgressVisible}">
                    <TextBlock Foreground="#FFE07070" Text="Cancel" />
                </Button>
                <Separator />
                <Label
                    d:Content="1024"
                    Content="{Binding AllocMem}"
                    ContentStringFormat="{}{0} MB RAM used"
                    ToolTip="Memory (MB)" />
            </ToolBar>
        </ToolBarTray>

        <!--  Left panel: Thumbnail grid (shown before analysis)  -->
        <!--  ListBox + VirtualizingWrapPanel: only visible items are realized.  -->
        <!--  The outer ScrollViewer is removed — ListBox has its own; an outer  -->
        <!--  one would give infinite height and defeat virtualization.  -->
        <ListBox
            Grid.Row="1"
            Grid.Column="0"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding ImageCollection}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.CacheLength="1,1"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding ThumbnailGridVisibility}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!--  Strip the default ListBox selection chrome so items look  -->
            <!--  exactly like the previous ItemsControl (no blue highlight)  -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type dto:ImageInfo}">
                    <Border
                        Width="200"
                        Height="230"
                        Margin="4"
                        Padding="2"
                        Background="#333"
                        BorderBrush="#444"
                        BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <Button
                                    Width="196"
                                    Height="200"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    ToolTip="{Binding FilePath}">
                                    <Button.InputBindings>
                                        <MouseBinding Command="{Binding ImageClick}" Gesture="Alt+LeftClick" />
                                        <MouseBinding Command="{Binding ImageDoubleClick}" Gesture="LeftDoubleClick" />
                                    </Button.InputBindings>
                                    <Grid Width="196" Height="200">
                                        <!--  Placeholder text is visible when Image is null  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="Gray"
                                            Text="Loading..." />
                                        <!--  Thumbnail image overlays the placeholder when loaded  -->
                                        <Image
                                            MaxWidth="196"
                                            MaxHeight="200"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{Binding Image, Mode=OneWay}"
                                            Stretch="Uniform" />
                                    </Grid>
                                </Button>
                                <TextBlock
                                    MaxWidth="196"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{Binding FileName}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource DeleteButtonStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  Left panel: Pair DataGrid (shown after analysis)  -->
        <DataGrid
            Grid.Row="1"
            Grid.Column="0"
            MaxWidth="{Binding GridWidth}"
            HorizontalAlignment="Left"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CellStyle="{StaticResource ImageCellStyle}"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="None"
            HorizontalScrollBarVisibility="Disabled"
            ItemsSource="{Binding PairDataCollection}"
            RowHeight="{Binding ThumbnailSize}"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            Visibility="{Binding PairGridVisibility}">
            <DataGrid.Columns>
                <DataGridTemplateColumn CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type helpers:ImagePair}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ThumbnailSize}" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="{Binding ThumbnailSize}" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Content="{Binding Image1.FileName}" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Content="{Binding Image2.FileName}" />

                                <Grid Grid.Row="1" Grid.Column="0">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ToolTip="{Binding Image1.FilePath}">
                                        <Button.InputBindings>
                                            <MouseBinding Command="{Binding Image1.ImageClick}" Gesture="Alt+LeftClick" />
                                            <MouseBinding Command="{Binding Image1DoubleClick}" Gesture="LeftDoubleClick" />
                                        </Button.InputBindings>
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{Binding Image1.Image, Mode=OneWay}"
                                            Tag="{Binding Image1.FilePath}" />
                                    </Button>
                                    <Button
                                        Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Image1}"
                                        Style="{StaticResource DeleteButtonStyle}" />
                                </Grid>
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinWidth="20">
                                    <Label HorizontalAlignment="Center" Content="{Binding BestDistance}" />
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.Column="2">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ToolTip="{Binding Image2.FilePath}">
                                        <Button.InputBindings>
                                            <MouseBinding Command="{Binding Image2.ImageClick}" Gesture="Alt+LeftClick" />
                                            <MouseBinding Command="{Binding Image2DoubleClick}" Gesture="LeftDoubleClick" />
                                        </Button.InputBindings>
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{Binding Image2.Image, Mode=OneWay}"
                                            Tag="{Binding Image2.FilePath}" />
                                    </Button>
                                    <Button
                                        Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Image2}"
                                        Style="{StaticResource DeleteButtonStyle}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  Loading indicator  -->
        <Label
            Grid.Row="1"
            Grid.Column="0"
            d:IsHidden="True"
            Content="Loading..."
            Style="{DynamicResource LoadingLabelStyle}" />

        <!--  Right panel: Image preview  -->
        <Border
            x:Name="PreviewContainer"
            Grid.Row="1"
            Grid.Column="1"
            Background="Transparent" />
        <Button
            Grid.Row="1"
            Grid.Column="1"
            Height="{Binding PreviewSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            d:IsHidden="True"
            PreviewMouseLeftButtonDown="PreviewButton_MouseLeftButtonDown"
            PreviewMouseLeftButtonUp="PreviewButton_MouseLeftButtonUp"
            UseLayoutRounding="False">
            <Button.InputBindings>
                <MouseBinding Command="{Binding CloseViewCommand}" Gesture="RightClick" />
                <MouseBinding
                    Command="{Binding ZoomInCommand}"
                    CommandParameter="{Binding ActualHeight, ElementName=PreviewImage, Mode=OneWay}"
                    Gesture="{x:Static helpers:MouseWheelGesture.Up}" />
                <MouseBinding
                    Command="{Binding ZoomOutCommand}"
                    CommandParameter="{Binding ActualHeight, ElementName=PreviewImage, Mode=OneWay}"
                    Gesture="{x:Static helpers:MouseWheelGesture.Down}" />
            </Button.InputBindings>
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Button.Template>
            <Image
                x:Name="PreviewImage"
                Width="{Binding CurrentImageView.Width, Mode=OneWay}"
                MaxWidth="100000000"
                MaxHeight="100000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Source="{Binding CurrentImageView, IsAsync=True, Mode=OneWay}" />
        </Button>
        <!--  Delete button for previewed image (top-right of preview area)  -->
        <Button
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,20,8,0"
            Padding="8,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="#FF737373"
            Command="{Binding DeletePreviewCommand}"
            Content="DELETE"
            FontWeight="Bold"
            Foreground="#FFEDEDED"
            Opacity="0.8"
            Visibility="{Binding PreviewDeleteVisibility}" />
    </Grid>
</Window>
